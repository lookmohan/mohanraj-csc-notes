/*FRIEND CLASS
````````````
The private members of one class can be accessed from the
member functions Of another class by making them as friends*/

/*#include<iostream>
using namespace std;
class second;
class first
{
private :
	int no;
public:
	friend class second;
	first(int n)
	{
no=n;
}};
class second
{
public:
	void show(first f)
	{
	cout<<f.no;
	}
};
int main()
{
first f(10);
second s;
s.show(f);
return 0;
}*/
